# YouTube Data API v3
YOUTUBE_API_KEY=

# PostgreSQL
POSTGRES_USER=garimpo
POSTGRES_PASSWORD=garimpo
POSTGRES_DB=garimpo
DATABASE_URL=postgresql://garimpo:garimpo@localhost:5433/garimpo
# Porta exposta no host para o Postgres do docker-compose (mude se 5433 já estiver em uso)
POSTGRES_HOST_PORT=5433
# Porta exposta no host para a API (mude se 8010 já estiver em uso)
APP_HOST_PORT=8010

# Dashboard (Streamlit) - senha compartilhada de acesso
DASHBOARD_PASSWORD=

# SMTP para envio de alertas por e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
