# YouTube Data API v3
YOUTUBE_API_KEY=
# Chaves adicionais separadas por vírgula, para rotacionar quando a cota diária
# (10.000 unidades por chave) se esgotar. Opcional.
YOUTUBE_API_KEYS=
# Região usada na busca e nos vídeos em alta
YOUTUBE_REGION_CODE=BR
# IDs de categoria para a descoberta por vídeos em alta (vazio = tendências gerais)
YOUTUBE_TRENDING_CATEGORY_IDS=

# Segredo para disparar POST /cron/discovery e /cron/snapshot de fora (ex.:
# GitHub Actions), usado em deploys sem processo de agendamento próprio
# (docs/07 — alternativa gratuita via Render). Vazio = endpoints desativados.
CRON_SECRET=

# Agendamento dos jobs de coleta (cron de 5 campos)
# Em deploys via GitHub Actions + /cron/*, desligue com SCHEDULER_ENABLED=false.
SCHEDULER_ENABLED=true
DISCOVERY_CRON=0 3 * * *
SNAPSHOT_CRON=0 5 * * *
# Fuso do agendamento (o container roda em UTC por padrão)
SCHEDULER_TIMEZONE=America/Sao_Paulo
# Se a máquina estiver parada na hora marcada, o job ainda roda quando voltar
# dentro desta janela (padrão: 6 horas). Sem isso, perdeu a hora, perdeu o dia.
SCHEDULER_MISFIRE_GRACE_SECONDS=21600
# Teto de cota por execução de cada job
DISCOVERY_QUOTA_BUDGET=3000
SNAPSHOT_QUOTA_BUDGET=6000
# Quantos nichos entram no rodízio de descoberta por execução
DISCOVERY_NICHES_PER_RUN=5
# Filtro de relevância da descoberta
DISCOVERY_MAX_SUBSCRIBERS=100000
DISCOVERY_MIN_VIEW_SUBSCRIBER_RATIO=1.0
DISCOVERY_VIDEO_WINDOW_DAYS=30
# Quantos vídeos recentes são analisados por canal em cada snapshot
RECENT_VIDEOS_COUNT=10

# Motor de score — pesos dos três componentes (devem somar 1.0)
SCORE_WEIGHT_GROWTH=0.5
SCORE_WEIGHT_MONETIZATION=0.3
SCORE_WEIGHT_NICHE=0.2
# Janela de comparação de crescimento entre snapshots
GROWTH_COMPARISON_DAYS=7
# Piso do denominador da taxa de crescimento (evita que +2 inscritos em um canal
# de 17 vire "crescimento de 12%" e domine o ranking)
GROWTH_MIN_BASE=1000
# Teto da extrapolação quando há menos histórico que a janela de referência
GROWTH_MAX_NORMALIZATION_FACTOR=3.0
# Acima desse tamanho o canal já emergiu e o crescimento pesa menos
GROWTH_LARGE_CHANNEL_SUBSCRIBERS=500000
GROWTH_LARGE_CHANNEL_FACTOR=0.5
# Sinais de monetização considerados ativos, escala do componente e dedupe
MONETIZATION_WINDOW_DAYS=30
MONETIZATION_SCORE_SCALE=25.0
MONETIZATION_SIGNAL_DEDUPE_DAYS=30
# Limiar público de inscritos do YouTube Partner Program
YPP_MIN_SUBSCRIBERS=1000

# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
# Porta exposta no host para o Postgres do docker-compose (mude se 5433 já estiver em uso)
POSTGRES_HOST_PORT=5433
# Porta exposta no host para a API (mude se 8010 já estiver em uso)
APP_HOST_PORT=8010

# Dashboard (Streamlit) - senha compartilhada de acesso
DASHBOARD_PASSWORD=
# Porta exposta no host para o dashboard (mude se 8501 já estiver em uso)
DASHBOARD_HOST_PORT=8501
# De onde o dashboard consome a API. No docker-compose isso é sobrescrito para
# http://app:8000; use localhost só ao rodar o Streamlit fora do container.
API_BASE_URL=http://localhost:8010

# SMTP para envio de alertas por e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# STARTTLS na porta 587; na porta 465 o SSL é usado automaticamente
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Aceita vários destinatários separados por vírgula
ALERT_EMAIL_TO=
# Score a partir do qual um canal vira alerta por e-mail
ALERT_SCORE_THRESHOLD=50.0

# --- Camada de oportunidade (Brecha Viral, docs/00b e docs/05) ---
# Até quantos segundos um vídeo conta como Short. Shorts e vídeos longos têm
# distribuições de views incomparáveis e só são comparados entre iguais.
SHORT_MAX_DURATION_SECONDS=180
# Ratio (views do vídeo / média do canal) que vale nota 100. A escala é
# logarítmica, para 1000x não empatar com 11x no teto.
OUTLIER_RATIO_TETO=100
# Piso do denominador: num canal que faz 380 views, um vídeo de 4 mil viraria
# "11x a média" sem provar que o formato funciona.
OUTLIER_MIN_BASELINE_VIEWS=5000
# Meia-vida do peso de recência, em dias, e seu piso.
OUTLIER_RECENCY_HALFLIFE_DAYS=30
OUTLIER_RECENCY_FLOOR=0.1
# A partir de que valor um número no título conta como promessa quantificada.
TITLE_MIN_NUMBER=5

# --- Brechas (Fase 9) ---
# Quantos mercados e quantas brechas por execução. Cada brecha custa ~101
# unidades de cota; medido, o sistema usa ~1.000 das 10.000 diárias.
MARKETS_PER_RUN=1
OPPORTUNITIES_PER_RUN=3
# Só vira candidata quem tem formato reconhecível no título: sem isto o topo
# da lista vira letra de música, que performa mas não é formato replicável.
EXIGIR_FORMATO_RECONHECIVEL=true
OUTLIER_MINIMO_PARA_BRECHA=20

# Aplica as migrations pendentes quando a API sobe. Ligado por padrão porque o
# passo manual foi esquecido e quebrou a produção de forma parcial e silenciosa.
RUN_MIGRATIONS_ON_STARTUP=true
